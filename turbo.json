{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env", ".env.development"],
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist"]
    },
    "dev": {
      "persistent": true,
      "interactive": true,
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^test"],
      "env": ["POSTGRES_*"],
      "passThroughEnv": ["CHROMIUM_EXECUTABLE"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"]
    },
    "test:e2e": {
      "cache": false,
      "passThroughEnv": ["CHROMIUM_EXECUTABLE", "CI"]
    }
  }
}
