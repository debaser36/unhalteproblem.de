{
  "json.schemaDownload.trustedDomains": {
    "https://turbo.build/schema.json": true
  },
  "nixEnvSelector.suggestion": false,
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "terminal.integrated.sendKeybindingsToShell": true,

  "ts.preferences.autoImportFileExcludePatterns": ["repos/**"],
  "js.preferences.autoImportFileExcludePatterns": ["repos/**"],

  "files.exclude": {
    "repos/**": true
  },

  "files.watcherExclude": {
    "repos/**": true
  },

  "search.exclude": {
    "repos/**": true
  }
}
