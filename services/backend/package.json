{
  "$schema": "https://json.schemastore.org/package",
  "name": "@unhalteproblem.de/backend",
  "description": "Backend service of unhalteproblem.de, implementing the @unhalteproblem.de/api contract",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#auth/*": "./src/auth/*.ts",
    "#Config": "./src/Config.ts",
    "#cqrs/*": "./src/cqrs/*.ts",
    "#domains/*": "./src/domains/*.ts",
    "#http/*": "./src/http/*.ts",
    "#infrastructure/*": "./src/infrastructure/*.ts",
    "#migrations/*": "./src/migrations/*.ts",
    "#testing/*": "./src/testing/*.ts"
  },
  "scripts": {
    "dev": "node --watch src/main.ts",
    "build": "rolldown src/main.ts --platform node --format esm --no-codeSplitting --file dist/main.js",
    "start": "node dist/main.js",
    "check-types": "tsc --noEmit -p .",
    "lint": "oxlint",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@effect/platform-node": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@unhalteproblem.de/api": "workspace:*",
    "@unhalteproblem.de/oidc": "workspace:*",
    "@unhalteproblem.de/seo": "workspace:*",
    "effect": "catalog:",
    "jose": "^6.2.12",
    "nodemailer": "^10.1.2",
    "stripe": "^23.0.0"
  },
  "devDependencies": {
    "@effect/sql-pglite": "catalog:",
    "@effect/tsgo": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/emscripten": "^1.41.6",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.2",
    "@unhalteproblem.de/tsconfig": "workspace:*",
    "oxlint": "catalog:",
    "rolldown": "^1.2.13",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
